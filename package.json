{
  "name": "mcp-winnow",
  "version": "0.1.0",
  "type": "module",
  "description": "Winnow — an embedded TypeScript SDK that lets an agent use many MCP servers without context bloat.",
  "license": "MIT",
  "author": "richpeaua",
  "homepage": "https://github.com/richpeaua/winnow#readme",
  "repository": { "type": "git", "url": "git+https://github.com/richpeaua/winnow.git" },
  "bugs": { "url": "https://github.com/richpeaua/winnow/issues" },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "context-bloat",
    "token-efficiency",
    "agent",
    "llm",
    "tools",
    "sdk",
    "gateway"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./gateway": { "types": "./dist/gateway/index.d.ts", "import": "./dist/gateway/index.js" }
  },
  "bin": { "mcp-winnow": "./dist/gateway/cli.js" },
  "files": ["dist", "docs", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "demo": "tsx examples/demo.ts",
    "gateway": "tsx src/gateway/cli.ts",
    "gateway:demo": "tsx examples/gateway-demo.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jmespath-community/jmespath": "^1.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orama/orama": "^3.1.18",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
